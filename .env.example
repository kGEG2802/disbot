# ============================================================
#  disbot — міст Discord -> Telegram
# ============================================================
#  УВАГА: DISCORD_TOKEN — це ваш КОРИСТУВАЦЬКИЙ токен (self-bot).
#  Використання порушує Правила Discord і може призвести до
#  блокування акаунта. Використовуйте на власний ризик.
#  Скопіюйте цей файл у .env та заповніть значення.
# ============================================================

# --- Discord ---
# Ваш користувацький токен (як його отримати — див. README).
DISCORD_TOKEN=

# --- Telegram ---
# Токен бота від @BotFather.
TELEGRAM_BOT_TOKEN=
# Ваш chat_id (отримати: напишіть боту, тоді @userinfobot, або /getUpdates).
TELEGRAM_CHAT_ID=

# --- Що пересилати ---
# Режим: all | mentions | keywords
FORWARD_MODE=all

# ID каналів, які слухати (через кому).
# Порожнє значення = усі видимі канали (дуже шумно!).
WATCH_CHANNELS=

# (необов'язково) Обмежити певними серверами — ID гільдій через кому.
WATCH_GUILDS=

# (необов'язково) Канали, які ігнорувати — ID через кому.
IGNORE_CHANNELS=

# Ключові слова через кому (потрібні, якщо FORWARD_MODE=keywords).
KEYWORDS=

# --- Поведінка ---
# Не пересилати ваші власні повідомлення.
IGNORE_SELF=true
# Пересилати повідомлення від ботів (true = пересилати).
IGNORE_BOTS=false
# Пересилати приватні повідомлення (DM).
INCLUDE_DMS=true
# Надсилати тестове повідомлення в Telegram при старті.
STARTUP_PING=true
